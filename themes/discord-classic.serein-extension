    "author": "niclas",
    "license": "MIT",
    "source": "",
    "kind": "theme"
  },
  "theme": {
    "dark": {
      "colors": {
        "base": "#1E1F22",
        "sidebar": "#2B2D31",
        "chat": "#313338",
        "raised": "#383A40",
        "hover": "#35373C",
        "selected": "#404249",
        "border": "#3F4147",
        "text_strong": "#F2F3F5",
        "text": "#DBDEE1",
        "muted": "#949BA4",
        "link": "#00A8FC",
        "accent": "#5865F2",
        "accent_text": "#FFFFFF",
        "positive": "#23A55A",
        "warning": "#F0B232",
        "danger": "#F23F43",
        "mention_bg": "#5865F24D",
